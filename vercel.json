{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/vercel.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/src/vercel"
    },
    {
      "source": "/api",
      "destination": "/backend/src/vercel"
    }
  ]
}