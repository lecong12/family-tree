{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/main.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "dest": "backend/src/main.ts"
    },
    {
      "source": "/((?!api/).*)",
      "dest": "/frontend/$1"
    }
  ]
}